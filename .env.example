# Database
DATABASE_URL=postgresql://architecture:architecture_password@localhost:5435/architecture_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRES_IN=7d

# Auth
REGISTER_INVITE_CODE=ARCHI2026

# CORS
CORS_ORIGIN=http://localhost:3000

# Docker host port (3002 on shared VPS — évite conflit avec une autre app sur 3000)
FRONTEND_HOST_PORT=3002

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Uploads
UPLOAD_DIR=uploads
